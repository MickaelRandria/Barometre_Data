# Backend
BACKEND_PORT=3001

# Météo — Open-Meteo (sans clé, appel direct)
# https://api.open-meteo.com — gratuit, pas d'inscription requise
# OPENWEATHER_API_KEY=  ← déprécié, remplacé par Open-Meteo

# Tendances
TRENDS_ENABLED=true

# Ministral (Mistral AI) — couche LLM OPTIONNELLE
# Sans clé, le pipeline reste 100% déterministe : aucune fonctionnalité ne se
# dégrade, la génération de variantes retombe intégralement sur les gabarits.
# Activée par requête via `useMistral: true` dans le brief envoyé à /api/agent.
# Ne jamais committer de vraie clé : renseignez-la dans .env (ignoré par git).
MISTRAL_API_KEY=
# Surcharge de l'URL de base, utile uniquement pour les tests avec un mock local.
# MISTRAL_API_BASE_URL=https://api.mistral.ai

# Frontend
VITE_API_URL=http://localhost:3001

# Administration : variables SERVEUR, jamais de préfixe VITE_.
# Définir les valeurs privées dans .env.local et dans Vercel > Settings > Environment Variables.
ADMIN_PASSWORD=example-password-change-before-use
ADMIN_SESSION_SECRET=example-session-secret-replace-with-64-random-hex-characters

# Audience — Upstash Redis (remplace Vercel KV), plan Free.
# Vercel > projet barometre-data > Storage > Create Database > Upstash Redis.
# Connecter la ressource au projet : les variables sont injectées automatiquement.
# Secrets serveur UNIQUEMENT : ne jamais préfixer ces variables par VITE_.
KV_REST_API_URL=https://example-redis.upstash.io
KV_REST_API_TOKEN=example-server-token-not-a-real-secret
# Les noms natifs Upstash sont également acceptés si KV_* n'est pas renseigné :
# UPSTASH_REDIS_REST_URL=https://example-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=example-server-token-not-a-real-secret
