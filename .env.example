# Backend
BACKEND_PORT=3001

# Météo — Open-Meteo (sans clé, appel direct)
# https://api.open-meteo.com — gratuit, pas d'inscription requise
# OPENWEATHER_API_KEY=  ← déprécié, remplacé par Open-Meteo

# Tendances
TRENDS_ENABLED=true

# Ministral (Mistral AI) — couche LLM OPTIONNELLE
# Sans clé, le pipeline reste 100% déterministe : aucune fonctionnalité ne se
# dégrade, la génération de variantes retombe intégralement sur les gabarits.
# Activée par requête via `useMistral: true` dans le brief envoyé à /api/agent.
# Ne jamais committer de vraie clé : renseignez-la dans .env (ignoré par git).
MISTRAL_API_KEY=
# Surcharge de l'URL de base, utile uniquement pour les tests avec un mock local.
# MISTRAL_API_BASE_URL=https://api.mistral.ai

# Frontend
VITE_API_URL=http://localhost:3001
